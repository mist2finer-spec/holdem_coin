# Copy settings into .env.pipeline.local (NOT the tracked .env).
# One provider key is enough. Keys must never be committed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=
# OpenAI reasoning effort is separate from the model ID.
AI_REASONING_EFFORT=medium
# Optional: otherwise uses an existing Git credential helper.
GITHUB_TOKEN=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTO_PIPELINE_WEB_TOKEN=
AUTO_PIPELINE_PORT=8787
